{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/map", "destination": "/map.html" },
    { "source": "/go", "destination": "/index.html" },
    { "source": "/pilot", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    }
  ]
}
